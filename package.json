{
  "name": "lyric-studio-desktop",
  "version": "0.1.1",
  "description": "Lyric Studio · versión de escritorio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "npx --yes electron-builder@26.18.0 --win --dir",
    "dist": "npx --yes electron-builder@26.18.0 --win"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^45.3.0"
  },
  "build": {
    "appId": "site.lyricstudio.desktop",
    "productName": "Lyric Studio",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "electron-ffmpeg.js",
      "desktop-auth-main.js",
      "projects-main.js",
      "main-i18n.js",
      "package.json",
      "editor/**/*",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "apple-touch-icon.png",
      "favicon-32.png"
    ],
    "extraResources": [
      {
        "from": "ffmpeg-bin",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "artifactName": "LyricStudio-Setup.exe",
      "oneClick": true,
      "perMachine": false
    }
  }
}
